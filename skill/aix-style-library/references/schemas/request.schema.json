{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aix-style-library.example/schemas/request.schema.json",
  "title": "Aix request",
  "oneOf": [
    { "$ref": "#/$defs/search" },
    { "$ref": "#/$defs/prepare" }
  ],
  "$defs": {
    "excludeItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reason"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api_version", "operation", "query", "terms", "category", "limit"],
      "properties": {
        "api_version": { "const": "1.0" },
        "operation": { "const": "search" },
        "query": { "type": "string", "minLength": 1, "maxLength": 500 },
        "terms": {
          "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 40 }
        },
        "category": {
          "oneOf": [
            { "type": "null" },
            { "enum": ["illustration", "painting", "photographic", "3d", "graphic"] }
          ]
        },
        "limit": { "type": "integer", "minimum": 1, "maximum": 5 }
      }
    },
    "prepare": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_version", "operation", "style_id", "style_version", "mode",
        "target", "strength", "intent", "resolution"
      ],
      "properties": {
        "api_version": { "const": "1.0" },
        "operation": { "const": "prepare" },
        "style_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "style_version": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
          ]
        },
        "mode": { "enum": ["prompt", "generate"] },
        "target": { "const": "generic-text-v1" },
        "strength": { "enum": ["light", "balanced", "strong"] },
        "intent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["description", "aspect_ratio", "text_literals", "must_preserve"],
          "properties": {
            "description": { "type": "string", "minLength": 1, "maxLength": 4000 },
            "aspect_ratio": {
              "oneOf": [
                { "type": "null" },
                { "type": "string", "pattern": "^\\s*[0-9]{1,3}\\s*:\\s*[0-9]{1,3}\\s*$" }
              ]
            },
            "text_literals": {
              "type": "array", "maxItems": 10,
              "items": { "type": "string", "minLength": 1, "maxLength": 200 }
            },
            "must_preserve": {
              "type": "array", "maxItems": 12,
              "items": { "type": "string", "minLength": 1, "maxLength": 200 }
            }
          }
        },
        "resolution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["exclude_features", "exclude_avoid"],
          "properties": {
            "exclude_features": {
              "type": "array",
              "items": { "$ref": "#/$defs/excludeItem" }
            },
            "exclude_avoid": {
              "type": "array",
              "items": { "$ref": "#/$defs/excludeItem" }
            }
          }
        }
      }
    }
  }
}
