{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aix-style-library.example/schemas/catalog.schema.json",
  "title": "Aix catalog index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "library_version", "source_digest", "styles"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "library_version": { "type": ["string", "null"] },
    "source_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "styles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "version", "status", "name", "description", "category",
          "tags", "aliases", "thumbnail_path", "thumbnail_alt", "content_hash"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^Aix(?:[0-9]{4}|[1-9][0-9]{4,7})$" },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "status": { "enum": ["draft", "active", "deprecated"] },
          "name": { "type": "string", "minLength": 1, "maxLength": 60 },
          "description": { "type": "string", "minLength": 1, "maxLength": 240 },
          "category": { "enum": ["illustration", "painting", "photographic", "3d", "graphic"] },
          "tags": { "type": "array", "items": { "type": "string" } },
          "aliases": { "type": "array", "items": { "type": "string" } },
          "thumbnail_path": { "type": "string", "pattern": "^styles/Aix[0-9]{4,8}/thumbnail\\.webp$" },
          "thumbnail_alt": { "type": "string", "minLength": 1, "maxLength": 180 },
          "content_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
